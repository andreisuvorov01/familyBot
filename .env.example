# ============================================
# Family Bot Configuration
# Скопируйте в .env и заполните ВСЕ значения
# ============================================

# Telegram Bot (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# URL вашего приложения (обязательно)
WEBAPP_URL=https://your-domain.example.com

# Секретный ключ JWT (обязательно, минимум 32 символа)
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_long_random_string_min_32_chars

# PostgreSQL (обязательно)
POSTGRES_PASSWORD=replace_with_strong_password

# Redis (опционально, используется для rate limiting в multi-worker)
REDIS_PASSWORD=replace_with_redis_password

# SSL / Certbot (обязательно для HTTPS)
CERTBOT_EMAIL=your-email@example.com

# ============================================
# Опциональные настройки
# ============================================

# CORS — укажите домен вашего фронтенда через запятую
# Если не задано — CORS отключён (только same-origin)
ALLOWED_ORIGINS=https://your-domain.example.com

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Часовой пояс по умолчанию для новых пользователей
# (Mini App подставляет пояс устройства автоматически)
DEFAULT_TIMEZONE=Europe/Moscow

# ============================================
# Google Calendar (опционально)
# ============================================
# Интеграция включается, когда заданы CLIENT_ID и CLIENT_SECRET.
# Redirect URI в Google Cloud: {WEBAPP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/google/callback
# Ключ Fernet для шифрования refresh token (если пусто — выводится из SECRET_KEY)
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Monitoring
GRAFANA_PASSWORD=replace_with_grafana_password
# SENTRY_DSN=https://key@sentry.io/project

# Режим
DEBUG=false
ENVIRONMENT=production
